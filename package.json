{
  "name": "pi-deu",
  "version": "0.1.0",
  "description": "pi-deu - opinionated Pi coding agent with mentor persona, 9-step Frame-to-Ship delivery chain, safety guards, memory and todo built-in",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-agent",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "pi-skill",
    "ai-coding-agent",
    "code-review",
    "agentic-workflow",
    "pi-deu"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "lib",
    "skills",
    "prompts",
    "index.ts",
    "README.md",
    "SYSTEM.md",
    "APPEND_SYSTEM.md"
  ],
  "bin": {
    "deu": "./index.ts"
  },
  "pi": {
    "system_prompt": "SYSTEM.md",
    "append_system_prompt": "APPEND_SYSTEM.md",
    "extensions": [
      "./extensions",
      "./node_modules/pi-subagents/index.js",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/pi-web-access/dist",
      "./node_modules/@gotgenes/pi-permission-system/src/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/@schovest/pi-goal/src/index.ts",
      "./node_modules/@upstash/context7-pi/extensions",
      "./node_modules/pi-cache-optimizer/index.ts",
      "./node_modules/pi-hermes-memory/src/index.ts",
      "./node_modules/pi-rewind-hook/index.ts",
      "./node_modules/@tylerho/pi-worktree/extensions",
      "./node_modules/@aliou/pi-guardrails/extensions"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-subagents/skills",
      "./node_modules/@upstash/context7-pi/skills",
      "./node_modules/@aliou/pi-utils-settings/skills",
      "./node_modules/@aliou/sh/skills"
    ],
    "prompts": [
      "./prompts",
      "./node_modules/pi-subagents/prompts",
      "./node_modules/@upstash/context7-pi/prompts"
    ]
  },
  "piConfig": {
    "name": "deu",
    "configDir": ".deu"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typebox": "1.3.34"
  },
  "dependencies": {
    "@gotgenes/pi-permission-system": "35.0.1",
    "@juicesharp/rpiv-ask-user-question": "2.11.0",
    "@juicesharp/rpiv-todo": "2.11.0",
    "@schovest/pi-goal": "0.2.0",
    "@upstash/context7-pi": "0.1.2",
    "pi-cache-optimizer": "2.8.11",
    "pi-hermes-memory": "0.9.9",
    "pi-mcp-adapter": "3.1.0",
    "pi-rewind-hook": "1.8.7",
    "pi-subagents": "0.73.1",
    "pi-web-access": "0.33.0",
    "@tylerho/pi-worktree": "0.2.1",
    "@aliou/pi-guardrails": "0.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.4",
    "typebox": "1.3.34",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "bundleDependencies": [
    "pi-subagents",
    "pi-mcp-adapter",
    "pi-web-access",
    "@juicesharp/rpiv-ask-user-question",
    "@gotgenes/pi-permission-system",
    "@upstash/context7-pi",
    "@schovest/pi-goal",
    "pi-hermes-memory",
    "@aliou/pi-guardrails",
    "@tylerho/pi-worktree",
    "@juicesharp/rpiv-todo",
    "pi-cache-optimizer",
    "pi-rewind-hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deuriib/pi-deu.git"
  },
  "homepage": "https://github.com/deuriib/pi-deu#readme",
  "bugs": {
    "url": "https://github.com/deuriib/pi-deu/issues"
  }
}
