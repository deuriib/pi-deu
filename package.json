{
  "name": "deu-pi-agent",
  "version": "0.1.0",
  "description": "Custom Pi agent autocontenido (deu): system prompt + pi-todo + pi-memory, todo declarado en package.json bajo src/",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extensions/*.ts"
    ],
    "skills": [
      "./src/skills/*/"
    ],
    "prompts": [
      "./src/prompts/*.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-subagents": "0.73.1",
    "pi-opencode-direct": "0.1.7",
    "pi-antigravity": "0.8.1",
    "pi-mcp-adapter": "3.1.0",
    "pi-web-access": "0.33.0",
    "@juicesharp/rpiv-ask-user-question": "2.11.0",
    "@gotgenes/pi-permission-system": "35.0.1",
    "@upstash/context7-pi": "0.1.2",
    "@schovest/pi-goal": "0.2.0",
    "pi-open-tui": "0.3.9",
    "pi-hermes-memory": "0.9.9",
    "@juicesharp/rpiv-todo": "2.11.0",
    "pi-cache-optimizer": "2.8.11",
    "@ar-llm/pi-custom-compaction": "0.5.0",
    "pi-rewind-hook": "1.8.7"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "assemble-system": "node scripts/assemble-system.mjs",
    "verify:v0": "npm run typecheck && node scripts/verify-v0.mjs"
  }
}
